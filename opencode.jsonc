{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/coding-config/.api-keys/context7}"
      },
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      "~/coding-config/skills"
    ]
  },
  "provider": {
    "krill-codex": {
      "npm": "@ai-sdk/openai",
      "name": "Krill",
      "options": {
        "baseURL": "https://api.krill-ai.net/codex/v1",
        "apiKey": "{file:~/coding-config/.api-keys/krill-codex}",
        "setCacheKey": true
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 353000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 353000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 353000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "forceReasoning": true,
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        }
      }
    },
    "krill-china": {
      "npm": "@ai-sdk/anthropic",
      "name": "Krill",
      "options": {
        "baseURL": "https://api.krill-ai.net/coding/v1",
        "apiKey": "{file:~/coding-config/.api-keys/krill-china}"
      },
      "models": {
        "deepseek-v4-pro-0813": {
          "name": "deepseek-v4-pro-0813",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "adaptive"
            }
          },
          "variants": {
            "low": {
              "effort": "low"
            },
            "high": {
              "effort": "high"
            },
            "max": {
              "effort": "max"
            }
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "deny",
      "str_replace_editor": "allow",
      "printf *": "allow",
      "bc *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "date *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "true": "allow",
      "true *": "allow",
      "false": "allow",
      "false *": "allow",
      "stat *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "du *": "allow",
      "df *": "allow",
      "wc *": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "file *": "allow",
      "jq *": "allow",
      "nl *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "paste *": "allow",
      "comm *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "dotenv": "allow",
      "dotenv *": "allow",
      "export *": "allow",
      "env": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "uname *": "allow",
      "id *": "allow",
      "whoami": "allow",
      "hostname *": "allow",
      "time *": "allow",
      "timeout *": "allow",
      "sed *": "allow",
      "mkdir *": "deny",
      "mkdir ./*": "allow",
      "mkdir /tmp/*": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git shortlog *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git ls-remote *": "allow",
      "git describe *": "allow",
      "git name-rev *": "allow",
      "git tag *": "allow",
      "git reflog *": "allow",
      "git remote *": "allow",
      "git config --get *": "allow",
      "git config --get-all *": "allow",
      "git config --list *": "allow",
      "git fetch *": "allow",
      "git clone *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git commit-tree *": "allow",
      "git switch *": "allow",
      "git checkout *": "allow",
      "git branch *": "allow",
      "git branch -d *": "ask",
      "git branch -D *": "ask",
      "git branch --delete *": "ask",
      "git merge *": "allow",
      "git rebase *": "allow",
      "git cherry-pick *": "allow",
      "git stash *": "allow",
      "git stash drop *": "ask",
      "git stash clear *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git rm *": "ask",
      "git push *": "deny",
      "git send-email *": "deny",
      "git remote add *": "ask",
      "git remote remove *": "ask",
      "git remote rename *": "ask",
      "git remote set-url *": "ask",
      "git tag -d *": "ask",
      "git tag --delete *": "ask",
      "rustfmt *": "allow",
      "rustc *": "allow",
      "cargo build *": "allow",
      "cargo test *": "allow",
      "cargo run *": "allow",
      "cargo bench *": "allow",
      "cargo fmt *": "allow",
      "cargo tree *": "allow",
      "cargo check *": "allow",
      "cargo clippy *": "allow",
      "cargo metadata *": "allow",
      "cargo search *": "allow",
      "cargo doc *": "allow",
      "cargo fetch *": "allow",
      "cargo locate-project *": "allow",
      "cargo pkgid *": "allow",
      "cargo read-manifest *": "allow",
      "cargo update *": "allow",
      "cargo generate-lockfile *": "allow",
      "cargo install *": "allow",
      "cargo uninstall *": "allow",
      "TRYBUILD=overwrite cargo test *": "allow",
      "cargo publish *": "deny",
      "cargo yank *": "deny",
      "cargo owner *": "deny",
      "cargo login *": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "corepack *": "allow",
      "pnpm *": "allow",
      "pnpx *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "tsc *": "allow",
      "tsx *": "allow",
      "ts-node *": "allow",
      "eslint *": "allow",
      "prettier *": "allow",
      "vitest *": "allow",
      "jest *": "allow",
      "biome *": "allow",
      "npm publish *": "deny",
      "npm unpublish *": "deny",
      "npm deprecate *": "deny",
      "npm dist-tag *": "deny",
      "npm owner *": "deny",
      "npm access *": "deny",
      "npm token *": "deny",
      "npm profile *": "deny",
      "npm login *": "ask",
      "npm logout *": "ask",
      "pnpm publish *": "deny",
      "pnpm unpublish *": "deny",
      "yarn npm publish *": "deny",
      "yarn npm tag add *": "deny",
      "yarn npm tag remove *": "deny",
      "bun publish *": "deny",
      "pip3 *": "deny",
      "uv *": "allow",
      "black *": "allow",
      "isort *": "allow",
      "coverage *": "allow",
      "tox *": "allow",
      "nox *": "allow",
      "twine check *": "allow",
      "twine upload *": "deny",
      "uv publish *": "deny",
      "poetry publish *": "deny",
      "hatch publish *": "deny",
      "test *": "allow",
      "curl *": "deny",
      "wget *": "deny",
      "rm -rf *": "deny",
      "rm -r -f *": "deny",
      "rm -f -r *": "deny",
      "rm --recursive --force *": "deny",
      "rm --force --recursive *": "deny",
      "rm /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm -rf /tmp/*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "poweroff *": "deny",
      "halt *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "dd *": "deny",
      "tee *": "deny",
      "* > *": "deny",
      "*>*": "deny",
      "* >> *": "deny",
      "*>>*": "deny",
      "* 1> *": "deny",
      "*1>*": "deny",
      "* 1>> *": "deny",
      "*1>>*": "deny",
      "* 2> *": "deny",
      "*2>*": "deny",
      "* 2>> *": "deny",
      "*2>>*": "deny",
      "* &> *": "deny",
      "*&>*": "deny",
      "grep * 2>/dev/null": "allow",
      "cat * 2>/dev/null": "allow",
      "sed * 2>/dev/null": "allow",
      "ls * 2>/dev/null": "allow"
    },
    "external_directory": {
      "/*": "deny",
      "~/chat_agent_scratchpad/**": "allow",
      "~/.cargo/**": "allow",
      "/tmp/**": "allow",
      "~/coding-config/**": "allow"
    },
    "lsp": "allow",
    "remove_voice_input_record": "ask"
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "prompt": "{file:~/coding-config/plan.txt}",
      "permission": {
        "lsp": "allow"
      }
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "general-qa": {
      "mode": "primary",
      "description": "Answer general question and perform conversation",
      "prompt": "{file:~/coding-config/general-qa.md}",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "permission": {
        "edit": {
          "*": "ask",
          "~/chat_agent_scratchpad/**": "allow"
        },
        "external_directory": {
          "*": "ask",
          "~/chat_agent_scratchpad/**": "allow"
        },
        "bash": {
          "uv run python *": "allow"
        }
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high"
    },
    "scout": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high"
    },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium"
    }
  },
  "small_model": "openai/gpt-5.6-luna",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@ljw1004/opencode-trace",
    "{env:HOME}/coding-config/deepseek-minimal-bootstrap/index.mjs"
  ]
}
