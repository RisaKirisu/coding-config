{
  "name": "dsh-profile-web",
  "private": true,
  "dependencies": {
    "@devvm/dsh-build-loop": "link:/root/.dsh/plugins/build-loop",
    "@devvm/dsh-remote-sync": "link:/root/.dsh/plugins/remote-sync",
    "@devvm/dsh-style-control": "link:/root/.dsh/plugins/style-control",
    "@devvm/dsh-subagent-manager": "link:/root/.dsh/plugins/subagent-manager",
    "@devvm/dsh-voice-input": "link:/root/.dsh/plugins/voice-input",
    "@hytime/dsh-thinking-effort": "^0.2.0",
    "dsh-better-sidebar": "^0.18.0",
    "dsh-skill-mcp-panel": "link:/root/.dsh/plugins/dsh-skill-mcp-panel"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@hytime/dsh-thinking-effort",
        "dsh-better-sidebar",
        "@devvm/dsh-remote-sync",
        "@devvm/dsh-subagent-manager",
        "@devvm/dsh-voice-input",
        "@devvm/dsh-style-control",
        "dsh-skill-mcp-panel",
        "@devvm/dsh-build-loop"
      ]
    }
  }
}
