{
  "name": "@devvm/dsh-build-loop",
  "version": "1.0.0",
  "description": "build_ticket tool: build agent, then parallel review and test audits with a bounded fix loop, plus a web settings page for its prompts and flow",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "loop.mjs",
    "config.mjs",
    "prompts.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
