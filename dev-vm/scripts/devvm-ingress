#!/usr/bin/env bash
set -euo pipefail

: "${DEVVM_PROJECT_HOST:?DEVVM_PROJECT_HOST is not set}"
install -d -m 0700 /run/devvm

PROJECT_ID="${DEVVM_PROJECT_ID:-}"
if [[ -z "$PROJECT_ID" && -f /root/workspace/.devvm-id ]]; then
    PROJECT_ID="$(head -n 1 /root/workspace/.devvm-id | tr -d '[:space:]')"
fi

INGRESS_LOG="/run/devvm/ingress.log"
if [[ -n "$PROJECT_ID" && -d /devvm-root ]]; then
    HOST_LOG_DIR="/devvm-root/.project-logs/$PROJECT_ID"
    install -d -m 0700 "$HOST_LOG_DIR"
    INGRESS_LOG="$HOST_LOG_DIR/ingress.log"
fi

prefix_lines() {
    while IFS= read -r line; do
        printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "$line"
    done
}

process_running() {
    local process="$1"
    local pid_file="$2"
    local pid

    [[ -r "$pid_file" ]] || return 1
    read -r pid < "$pid_file"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [[ "$(<"/proc/$pid/comm")" == "$process" ]]
}

adopt_running_process() {
    local process="$1"
    local pid_file="$2"
    local pid

    process_running "$process" "$pid_file" && return
    pid="$(pgrep -xo "$process" || true)"
    [[ -n "$pid" ]] || return 1
    printf '%s\n' "$pid" > "$pid_file"
}

if ! adopt_running_process caddy /run/devvm/caddy.pid; then
    caddy start \
        --config /etc/devvm/Caddyfile \
        --adapter caddyfile \
        --pidfile /run/devvm/caddy.pid \
        >> "$INGRESS_LOG" 2>&1
fi

if ! adopt_running_process frpc /run/devvm/frpc.pid; then
    # Process substitution, not a pipe: `$!` must stay frpc's pid, not the prefixer's.
    nohup frpc -c /etc/devvm/frpc.toml > >(prefix_lines >> "$INGRESS_LOG") 2>&1 &
    printf '%s\n' "$!" > /run/devvm/frpc.pid
fi
