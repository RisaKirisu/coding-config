#!/usr/bin/env bash
set -euo pipefail

DEVVM_HOME="${DEVVM_HOME:-$HOME/coding-config/dev-vm}"
FRPS_BIN="$HOME/.local/bin/frps"

ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)        ARCH=amd64 ;;
    aarch64|arm64) ARCH=arm64 ;;
    *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

INGRESS_PORT=17007
HTTP_PORT=8102

PROJECT_DIR="$(realpath "$PWD")"
PROJECT_NAME="$(printf '%s' "$(basename "$PROJECT_DIR")" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-')"
PROJECT_NAME="${PROJECT_NAME#-}"
PROJECT_NAME="${PROJECT_NAME%-}"
if command -v sha256sum >/dev/null 2>&1; then sha256() { sha256sum; }; else sha256() { shasum -a 256; }; fi
PROJECT_HASH="$(printf '%s' "$PROJECT_DIR" | sha256 | cut -c1-8)"
PROJECT_HOST="${PROJECT_NAME}-${PROJECT_HASH}"
NAME="dev-${PROJECT_NAME}-${PROJECT_HASH}"

IMAGE="$DEVVM_HOME/rust-dev-opencode-$ARCH.tar"
SMOLFILE="$DEVVM_HOME/smolvm.toml"
DEVVM_ROOT="$DEVVM_HOME/root"

ensure_ingress() {
    if [[ ! -x "$FRPS_BIN" ]]; then
        echo "devvm HTTP ingress is not installed; run $DEVVM_HOME/setup-devvm.sh" >&2
        exit 1
    fi

    local command="$FRPS_BIN --bind-addr 127.0.0.1 --bind-port $INGRESS_PORT --vhost-http-port $HTTP_PORT"
    if pgrep -u "$(id -u)" -f "^$command$" >/dev/null; then
        return
    fi

    nohup "$FRPS_BIN" \
        --bind-addr 127.0.0.1 \
        --bind-port "$INGRESS_PORT" \
        --vhost-http-port "$HTTP_PORT" \
        >/dev/null 2>&1 &
    local pid=$!
    sleep 0.2
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Failed to start devvm HTTP ingress" >&2
        exit 1
    fi
}

exists() {
    smolvm machine status --name "$NAME" >/dev/null 2>&1
}

create() {
    ensure_ingress
    if ! exists; then
        echo "Creating $NAME"
        smolvm machine create \
             --name "$NAME" \
             -s "$SMOLFILE" \
             --net-backend virtio-net \
             --image "$IMAGE" \
             -e "DEVVM_PROJECT_HOST=$PROJECT_HOST" \
             -v "$PROJECT_DIR:/workspace/$(basename "$PROJECT_DIR")" \
             -v "$DEVVM_ROOT:/devvm-root"
    fi
}

link_root() {
    smolvm machine exec --name "$NAME" -- /bin/bash -c '
        set -euo pipefail
        shopt -s dotglob nullglob

        # A macOS host shares /devvm-root over a virtiofs server that hands back
        # a read-only fd for a file published with link()+unlink() (write EBADF,
        # ftruncate EINVAL). That is exactly how dsh writes a session log, so
        # its session state cannot live on the mount there. Linux hosts are fine.
        split_dsh=""
        [[ "$1" == "Darwin" ]] && split_dsh=1

        install -d /root/.config
        for source in /devvm-root/.config/*; do
            target="/root/.config/${source##*/}"
            rm -rf -- "$target"
            ln -s "$source" "$target"
        done

        if [[ -n "$split_dsh" ]]; then
            if [[ -L /root/.dsh ]]; then rm -f /root/.dsh; fi
            install -d -m 700 /root/.dsh /root/.dsh/sessions /root/.dsh/storages
            for source in /devvm-root/.dsh/*; do
                name="${source##*/}"
                [[ "$name" == "sessions" || "$name" == "storages" ]] && continue
                target="/root/.dsh/$name"
                rm -rf -- "$target"
                ln -s "$source" "$target"
            done
        fi

        for source in /devvm-root/*; do
            name="${source##*/}"
            [[ "$name" == ".config" ]] && continue
            [[ -n "$split_dsh" && "$name" == ".dsh" ]] && continue
            target="/root/$name"
            rm -rf -- "$target"
            ln -s "$source" "$target"
        done
    ' link-root "$(uname -s)"
}

start_ingress() {
    smolvm machine exec --name "$NAME" -- /usr/local/bin/devvm-ingress
}

start() {
    smolvm machine start --name "$NAME"
    start_ingress
    link_root
}

case "${1:-shell}" in
    start)
        create
        start
        ;;

    shell)
        create
        start
        echo "HTTP: http://<port>.$PROJECT_HOST.devvm.localhost:$HTTP_PORT"
        smolvm machine exec -it --name "$NAME" -- /bin/bash
        ;;

    exec)
        shift
        create
        start
        smolvm machine exec --stream --name "$NAME" -- "$@"
        ;;

    stop)
        smolvm machine stop --name "$NAME"
        ;;

    status)
        smolvm machine status --name "$NAME"
        ;;

    rm|delete)
        smolvm machine stop --name "$NAME" 2>/dev/null || true
        smolvm machine delete --name "$NAME" -f
        ;;

    name)
        echo "$NAME"
        ;;

    *)
        echo "Usage: devvm {start|shell|exec|stop|status|rm|name}"
        exit 1
        ;;
esac
