#!/usr/bin/env bash
set -euo pipefail

DEVVM_HOME="${DEVVM_HOME:-$HOME/coding-config/dev-vm}"
FRPS_BIN="${FRPS_BIN:-$HOME/.local/bin/frps}"

ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)        ARCH=amd64 ;;
    aarch64|arm64) ARCH=arm64 ;;
    *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

INGRESS_PORT=17007
HTTP_PORT=8102
FRPS_TIMEOUT=1800

PROJECT_DIR="$(realpath "$PWD")"
PROJECT_NAME="$(printf '%s' "$(basename "$PROJECT_DIR")" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-')"
PROJECT_NAME="${PROJECT_NAME#-}"
PROJECT_NAME="${PROJECT_NAME%-}"
[[ -z "$PROJECT_NAME" ]] && PROJECT_NAME="project"
if command -v sha256sum >/dev/null 2>&1; then sha256() { sha256sum; }; else sha256() { shasum -a 256; }; fi
PROJECT_HASH="$(printf '%s' "$PROJECT_DIR" | sha256 | cut -c1-8)"
PROJECT_HOST="${PROJECT_NAME}-${PROJECT_HASH}"
if [[ ${#PROJECT_HOST} -gt 57 ]]; then PROJECT_HOST="$PROJECT_HASH"; fi
NAME="dev-${PROJECT_NAME}-${PROJECT_HASH}"

IMAGE="$DEVVM_HOME/rust-dev-opencode-$ARCH.tar"
SMOLFILE="$DEVVM_HOME/smolvm.toml"
DEVVM_ROOT="$DEVVM_HOME/root"

ensure_ingress() {
    if [[ ! -x "$FRPS_BIN" ]]; then
        echo "devvm HTTP ingress is not installed; run $DEVVM_HOME/setup-devvm.sh" >&2
        exit 1
    fi

    local command=(
        "$FRPS_BIN"
        --bind-addr 127.0.0.1
        --bind-port "$INGRESS_PORT"
        --proxy-bind-addr 127.0.0.1
        --vhost-http-port "$HTTP_PORT"
        --vhost-http-timeout "$FRPS_TIMEOUT"
    )
    if pgrep -u "$(id -u)" -f "^${command[*]}$" >/dev/null; then
        return
    fi

    local log_dir="$HOME/.local/state/devvm"
    install -d -m 0700 "$log_dir"
    nohup "${command[@]}" >>"$log_dir/frps.log" 2>&1 &
    local pid=$!
    sleep 0.2
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Failed to start devvm HTTP ingress" >&2
        exit 1
    fi
}

ensure_project_id() {
    local id_file="$PROJECT_DIR/.devvm-id"
    if [[ ! -f "$id_file" || ! -s "$id_file" ]]; then
        local uuid=""
        if [[ -r /proc/sys/kernel/random/uuid ]]; then
            uuid="$(cat /proc/sys/kernel/random/uuid)"
        elif command -v uuidgen >/dev/null 2>&1; then
            uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        elif command -v python3 >/dev/null 2>&1; then
            uuid="$(python3 -c 'import uuid; print(uuid.uuid4())')"
        fi
        if [[ -z "$uuid" ]]; then
            echo "Failed to generate UUID for .devvm-id" >&2
            exit 1
        fi
        printf '%s\n' "$uuid" > "$id_file"
    fi
}

exists() {
    smolvm machine ls --json |
        jq -e --arg name "$NAME" \
        'any(.[]; .name == $name)' >/dev/null
}

running() {
    smolvm machine ls --json |
        jq -e --arg name "$NAME" \
        'any(.[]; .name == $name and .state == "running")' >/dev/null
}

create() {
    ensure_project_id
    if exists; then
        return
    fi

    echo "Creating $NAME"
    smolvm machine create \
         --name "$NAME" \
         -s "$SMOLFILE" \
         --net-backend virtio-net \
         --image "$IMAGE" \
         -e "DEVVM_PROJECT_HOST=$PROJECT_HOST" \
         -v "$PROJECT_DIR:/root/workspace" \
         -v "$DEVVM_ROOT:/devvm-root"
}

link_root() {
    smolvm machine exec --name "$NAME" -- /bin/bash -c '
        set -euo pipefail
        shopt -s dotglob nullglob

        install -d /root/.config
        for source in /devvm-root/.config/*; do
            target="/root/.config/${source##*/}"
            rm -rf -- "$target"
            ln -s "$source" "$target"
        done

        # DSH saves by renaming a temp sibling over the target, which replaces a
        # symlink instead of writing through it, so /root/.dsh is a bind mount of
        # the shared directory and Portable DSH State stays VM-local underneath.
        install -d -m 700 /var/lib/devvm-dsh/{sessions,storages,attachments}

        if ! mountpoint -q /root/.dsh; then
            for name in sessions storages attachments; do
                dir="/root/.dsh/$name"
                if [[ -d "$dir" && ! -L "$dir" ]] && ! mountpoint -q "$dir"; then
                    contents=("$dir"/*)
                    if (( ${#contents[@]} > 0 )); then
                        mv -- "${contents[@]}" "/var/lib/devvm-dsh/$name/"
                    fi
                fi
            done
        fi

        if [[ -L /root/.dsh ]]; then rm -f /root/.dsh; fi
        install -d -m 700 /root/.dsh
        mountpoint -q /root/.dsh || mount --bind /devvm-root/.dsh /root/.dsh
        for name in sessions storages attachments; do
            mountpoint -q "/root/.dsh/$name" || mount --bind "/var/lib/devvm-dsh/$name" "/root/.dsh/$name"
        done

        for source in /devvm-root/*; do
            name="${source##*/}"
            [[ "$name" == ".config" || "$name" == ".dsh" ]] && continue
            target="/root/$name"
            rm -rf -- "$target"
            ln -s "$source" "$target"
        done

        if command -v dsh >/dev/null 2>&1; then
            store=/root/workspace/.pnpm-store/v11
            for name in web headless; do
                profile="/root/.dsh/profiles/$name"
                if [[ -f "$profile/package.json" ]] \
                    && { [[ ! -f "$profile/node_modules/.pnpm/lock.yaml" ]] \
                        || ! cmp -s "$profile/pnpm-lock.yaml" "$profile/node_modules/.pnpm/lock.yaml"; }; then
                    CI=true DSH_HOME=/root/.dsh dsh plugin --profile "$name" install --frozen-lockfile --store-dir "$store"
                fi
            done
        fi
    ' link-root
}

start_ingress() {
    smolvm machine exec --name "$NAME" -- /usr/local/bin/devvm-ingress
}

clear_crane() {
    smolvm machine exec \
        --name "$NAME" \
        -- /bin/bash \
        -c "rm -rf /storage/tmp/* && fstrim /storage"
}

start() {
    if running; then
        return
    fi

    ensure_ingress
    smolvm machine start --name "$NAME"
    start_ingress
    link_root
    clear_crane
}

case "${1:-shell}" in
    start)
        create
        start
        ;;

    shell)
        create
        start
        echo "HTTP: http://<port>.$PROJECT_HOST.devvm.localhost:$HTTP_PORT"
        smolvm machine exec -it --name "$NAME" -- /bin/bash
        ;;

    exec)
        shift
        if [[ "${1:-}" == "--" ]]; then
            shift
        fi
        create
        start
        smolvm machine exec --stream --name "$NAME" -- "$@"
        ;;

    stop)
        smolvm machine stop --name "$NAME"
        ;;

    status)
        smolvm machine ls --json |
        jq -r --arg name "$NAME" '
            .[] | select(.name == $name) |
            "Machine '\''\(.name)'\'': \(.state)"
        '
        ;;

    memory)
        if ! running; then
            exit 1
        fi
        machine_info="$(smolvm machine ls --json 2>/dev/null | jq -c --arg name "$NAME" '.[] | select(.name == $name)' 2>/dev/null || true)"
        if [[ -z "$machine_info" ]]; then
            exit 1
        fi
        limit_mib="$(printf '%s' "$machine_info" | jq -r '.memory_mib // empty')"
        pid="$(printf '%s' "$machine_info" | jq -r '.pid // empty')"

        host_bytes=""
        if [[ -n "$pid" && -d "/proc/$pid" ]]; then
            pages="$(awk '{print $2}' "/proc/$pid/statm" 2>/dev/null || true)"
            if [[ -n "$pages" ]]; then
                page_size="$(getconf PAGESIZE 2>/dev/null || echo 4096)"
                host_bytes=$(( pages * page_size ))
            fi
        fi
        if [[ -z "$host_bytes" && -n "$pid" ]]; then
            rss_kb="$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
            if [[ -n "$rss_kb" && "$rss_kb" =~ ^[0-9]+$ ]]; then
                host_bytes=$(( rss_kb * 1024 ))
            fi
        fi

        guest_bytes=""
        meminfo="$(smolvm machine exec --name "$NAME" -- /bin/sh -c 'cat /proc/meminfo' 2>/dev/null || true)"
        if [[ -n "$meminfo" ]]; then
            total_kb="$(printf '%s\n' "$meminfo" | awk '/^MemTotal:/ {print $2}')"
            avail_kb="$(printf '%s\n' "$meminfo" | awk '/^MemAvailable:/ {print $2}')"
            if [[ -n "$total_kb" && -n "$avail_kb" ]]; then
                used_kb=$(( total_kb - avail_kb ))
                if (( used_kb >= 0 )); then
                    guest_bytes=$(( used_kb * 1024 ))
                fi
            fi
        fi

        limit_bytes=""
        if [[ -n "$limit_mib" && "$limit_mib" =~ ^[0-9]+$ ]]; then
            limit_bytes=$(( limit_mib * 1048576 ))
        fi

        printf '{"host_bytes":%s,"guest_bytes":%s,"limit_bytes":%s}\n' \
            "${host_bytes:-null}" "${guest_bytes:-null}" "${limit_bytes:-null}"
        ;;

    rm|delete)
        smolvm machine stop --name "$NAME" 2>/dev/null || true
        smolvm machine delete --name "$NAME" -f
        ;;

    name)
        echo "$NAME"
        ;;

    *)
        echo "Usage: devvm {start|shell|exec|stop|status|memory|rm|name}"
        exit 1
        ;;
esac
