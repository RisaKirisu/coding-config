{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{file:.api-keys/context7}"
            },
            "enabled": true
        }
    },
    "provider": {
        "krill-codex": {
            "npm": "@ai-sdk/openai",
            "name": "Krill",
            "options": {
                "baseURL": "https://api.krill-ai.com/codex/v1",
                "apiKey": "{file:.api-keys/krill}",
                "setCacheKey": true
            },
            "models": {
                "gpt-5.6-sol": {
                    "name": "GPT 5.6 Sol",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 353000,
                        "output": 128000
                    },
                    "variants": {
                        "xhigh": {
                            "reasoningEffort": "xhigh",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "high": {
                            "reasoningEffort": "high",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "medium": {
                            "reasoningEffort": "medium",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "none": {
                            "reasoningEffort": "none",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        }
                    }
                },
                "gpt-5.6-terra": {
                    "name": "GPT 5.6 Terra",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 353000,
                        "output": 128000
                    },
                    "variants": {
                        "xhigh": {
                            "reasoningEffort": "xhigh",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "high": {
                            "reasoningEffort": "high",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "medium": {
                            "reasoningEffort": "medium",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "none": {
                            "reasoningEffort": "none",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        }
                    }
                },
                "gpt-5.6-luna": {
                    "name": "GPT 5.6 Luna",
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 353000,
                        "output": 128000
                    },
                    "variants": {
                        "xhigh": {
                            "reasoningEffort": "xhigh",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "high": {
                            "reasoningEffort": "high",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "medium": {
                            "reasoningEffort": "medium",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "forceReasoning": true,
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        },
                        "none": {
                            "reasoningEffort": "none",
                            "reasoningSummary": "auto",
                            "textVerbosity": "medium",
                            "include": [
                                "reasoning.encrypted_content"
                            ]
                        }
                    }
                }
            }
        }
    },
    "lsp": true,
    "permission": {
        "*": "allow"
    },
    "agent": {
        "build": {
            "model": "openai/gpt-5.6-sol",
            "reasoningEffort": "high"
        },
        "explore": {
            "model": "openai/gpt-5.6-terra",
            "reasoningEffort": "high"
        },
        "scout": {
            "model": "openai/gpt-5.6-terra",
            "reasoningEffort": "high"
        },
        "general": {
            "model": "openai/gpt-5.6-sol",
            "reasoningEffort": "medium"
        },
        "compaction": {
            "model": "openai/gpt-5.6-sol",
            "reasoningEffort": "medium"
        }
    },
    "small_model": "openai/gpt-5.6-luna",
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "./plugins/deepseek-minimal-bootstrap/index.mjs"
    ]
}